;;; Opener & Registration
;;; ---------------------------------------------------------------------------

(defun etaf-web-docs--open (ctx)
  "Open a Docs split-tree view for CTX, or return `fallback' when unsuitable."
  (let* ((url (plist-get ctx :url))
         (html (plist-get ctx :html))
         (dom (or (plist-get ctx :dom)
                  (and (stringp html) (etaf-web--parse-html html))))
         (sidebar (and dom (etaf-web-docs--find-sidebar dom url))))
    (if (not sidebar)
        'fallback
      (let* ((tree (etaf-web-docs--extract-tree sidebar url))
             (items (plist-get tree :items))
             (leaves (plist-get tree :leaves)))
        (if (or (null items) (< (length leaves) 3))
            'fallback
          (let* ((page-dir (etaf-web--page-dir url))
                 (index-file (expand-file-name "index.md" page-dir))
                 (rewriter (etaf-web--make-local-image-rewriter page-dir))
                 (compiled (etaf-web--compile html :base-url url
                                              :image-rewriter rewriter))
                 (markdown (plist-get compiled :markdown))
                 (title (or (plist-get compiled :title)
                            (car (etaf-web--url-parts url))))
                 (engine (etaf-web-docs--detect-engine dom))
                 (pn (etaf-web-docs--resolve-prev-next
                      dom leaves (plist-get tree :active-key) url))
                 (navigate (plist-get ctx :navigate))
                 (open-link (plist-get ctx :open-link))
                 (focus-input (plist-get ctx :focus-input))
                 (on-ready (plist-get ctx :on-ready))
                 (buf (plist-get ctx :buffer))
                 (sidebar-width-ref (or (plist-get ctx :sidebar-width-px)
                                        (etaf-ref nil :name 'docs-sidebar-width)))
                 (measure-ref (or (plist-get ctx :docs-measure)
                                  (etaf-ref 84 :name 'docs-measure)))
                 (disposed nil)
                 (img-cancel nil))
            (if (etaf-web--markdown-thin-p markdown)
                'fallback
              (make-directory page-dir t)
              (etaf-web--write-utf8 (expand-file-name "source.html" page-dir) html)
              (etaf-web--write-utf8 index-file markdown)
              (etaf-web--write-meta page-dir url title nil)
              (let* ((doc (etaf-web--parse-embedded-markdown markdown))
                     (outline (etaf-web--markdown-outline doc))
                     (key-to-url (plist-get tree :key-to-url))
                     (collapsed-ref (etaf-ref nil :name 'docs-collapsed))
                     (drawer-open-ref (etaf-ref nil :name 'docs-drawer-open))
                     (filter-ref (etaf-ref "" :name 'docs-filter))
                     (expanded-ref (etaf-ref (plist-get tree :expanded)
                                             :name 'docs-expanded))
                     (media-rev (etaf-ref 0 :name 'docs-media-rev))
                     (window-metrics
                      (lambda ()
                        (let* ((win (and (buffer-live-p buf)
                                         (get-buffer-window buf t)))
                               (live (window-live-p win))
                               (w (if live (window-body-width win) 96))
                               (cell-w (car (etaf-web--cell-metrics)))
                               (px (if live (window-body-width win t) (* w cell-w)))
                               (cw (if (and live (> w 0) (> px 0))
                                       (/ (float px) w)
                                     (float cell-w))))
                          (list w px cw))))
                     (toggle-sidebar
                      (lambda ()
                        (interactive)
                        (let ((vw (nth 0 (funcall window-metrics))))
                          (if (< vw etaf-web-docs--wide-breakpoint)
                              (etaf-set-value drawer-open-ref
                                              (not (etaf-value drawer-open-ref)))
                            (etaf-set-value collapsed-ref
                                            (not (etaf-value collapsed-ref)))))))
                     (step-sidebar
                      (lambda (delta-cols)
                        (let* ((m (funcall window-metrics))
                               (vw (nth 0 m))
                               (vw-px (nth 1 m))
                               (cw (nth 2 m))
                               (min-px (round (* etaf-web-docs--min-sidebar-cols cw)))
                               (max-px (max (+ min-px (round (* 6 cw)))
                                            (round (* 0.44 vw-px))))
                               (cur (or (etaf-value sidebar-width-ref)
                                        (round (* etaf-web-docs--default-sidebar-cols cw))))
                               (next (max min-px (min max-px (+ cur (round (* delta-cols cw)))))))
                          (when (>= vw etaf-web-docs--wide-breakpoint)
                            (etaf-set-value collapsed-ref nil)
                            (etaf-set-value sidebar-width-ref next)
                            (message "侧栏宽度: %d 列" (round (/ (float next) cw)))))))
                     (focus-filter
                      (lambda ()
                        (interactive)
                        (let ((vw (nth 0 (funcall window-metrics))))
                          (if (< vw etaf-web-docs--wide-breakpoint)
                              (progn
                                (etaf-set-value drawer-open-ref t)
                                (when (functionp focus-input)
                                  (funcall focus-input 'docs-drawer-filter)))
                            (etaf-set-value collapsed-ref nil)
                            (when (functionp focus-input)
                              (funcall focus-input 'docs-sidebar-filter))))))
                     (st (list :title title
                               :engine engine
                               :doc doc
                               :page-dir page-dir
                               :open-link open-link
                               :media-rev media-rev
                               :tree-items items
                               :leaves leaves
                               :active-key (plist-get tree :active-key)
                               :lang-switch (plist-get tree :lang-switch)
                               :breadcrumb (plist-get tree :breadcrumb)
                               :prev (car pn)
                               :next (cdr pn)
                               :navigate navigate
                               :sidebar-width-ref sidebar-width-ref
                               :measure-ref measure-ref
                               :collapsed-ref collapsed-ref
                               :drawer-open-ref drawer-open-ref
                               :filter-ref filter-ref
                               :expanded-ref expanded-ref
                               :on-toggle-sidebar toggle-sidebar
                               :on-open-drawer
                               (lambda () (etaf-set-value drawer-open-ref t))
                               :on-select
                               (lambda (k)
                                 (when-let* ((target (gethash k key-to-url)))
                                   (etaf-set-value drawer-open-ref nil)
                                   (funcall navigate target))))))
                (funcall
                 on-ready
                 (list :title title
                       :mode-label "文档"
                       :own-scroll t
                       :outline outline
                       :render (lambda (rctx) (etaf-web-docs--render-view st rctx))
                       :keys (delq
                              nil
                              (list
                               (list "s" toggle-sidebar "切换文档目录")
                               (list "/" focus-filter "筛选文档章节")
                               (list "[" (lambda () (interactive) (funcall step-sidebar -4))
                                     "缩窄侧栏")
                               (list "]" (lambda () (interactive) (funcall step-sidebar 4))
                                     "加宽侧栏")
                               (when (car pn)
                                 (let ((purl (plist-get (car pn) :url)))
                                   (list "H"
                                         (lambda () (interactive) (funcall navigate purl))
                                         "上一章")))
                               (when (cdr pn)
                                 (let ((nurl (plist-get (cdr pn) :url)))
                                   (list "L"
                                         (lambda () (interactive) (funcall navigate nurl))
                                         "下一章")))))
                       :on-width (lambda (delta)
                                   (let* ((cur (or (etaf-value measure-ref) 84))
                                          (next (max 56 (min 112 (+ cur delta)))))
                                     (etaf-set-value measure-ref next)
                                     next))
                       :dispose (lambda ()
                                  (setq disposed t)
                                  (when (functionp img-cancel)
                                    (ignore-errors (funcall img-cancel))
                                    (setq img-cancel nil)))))
                ;; Async image backfill for embedded Markdown view.
                (when (and etaf-web-download-images
                           (etaf-web--remote-image-references markdown))
                  (setq img-cancel
                        (etaf-web--backfill-images-async
                         page-dir index-file
                         (lambda (changed)
                           (when (and changed (not disposed) (buffer-live-p buf))
                             (etaf-set-value media-rev (1+ (etaf-value media-rev)))
                             (when-let* ((rt (etaf-runtime-for-buffer buf)))
                               (ignore-errors (etaf-runtime-flush rt)))))
                         url)))
                (lambda ()
                  (setq disposed t)
                  (when (functionp img-cancel)
                    (ignore-errors (funcall img-cancel))
                    (setq img-cancel nil)))))))))))

(etaf-web-register-adapter
 :name 'docs
 :label "文档"
 :priority 60
 :match-html #'etaf-web-docs--match-html-p
 :open #'etaf-web-docs--open)

(provide 'etaf-web-adapter-docs)
