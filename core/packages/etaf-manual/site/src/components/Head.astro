---
// Extend Starlight's default <Head> with localized 1200x630 OpenGraph cards
// generated from src/og-manifest.json at build time.
import Default from '@astrojs/starlight/components/Head.astro';
import ogHashes from '../og-hashes.json';

const hashes = ogHashes as Record<string, string>;
const route = Astro.locals.starlightRoute;
const entry = route.entry;
const pageTitle = entry?.data?.title || 'ETAF Reference Manual';
const isZh = route.lang === 'zh-CN' || Astro.url.pathname.startsWith('/zh-cn/');
const siteLabel = isZh ? 'ETAF 参考手册' : 'ETAF Reference Manual';
const fallbackDesc = isZh
  ? '《ETAF 参考手册》：在 Emacs 中构建文本应用的概念模型与公共接口。'
  : 'ETAF Reference Manual: concepts and public interfaces for building text applications in Emacs.';
const pageDescription = entry?.data?.description || fallbackDesc;

const ogKey = isZh ? 'manual-zh' : 'manual-en';
const ogPath = isZh ? '/og/manual-zh.png' : '/og/manual.png';
const ogHash = hashes[ogKey];
const ogImage = `https://etaf.top${ogPath}${ogHash ? `?v=${ogHash}` : ''}`;
const ogAlt = `${pageTitle} — ${siteLabel}`;
---
<Default />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />
