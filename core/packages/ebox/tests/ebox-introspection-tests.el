(require 'ebox-test-support)

(ert-deftest ebox-node-box-metrics-reports-resolved-box-model ()
  (ebox-test-with-mounted (buffer root
                           '(column :width (ch 40)
                             (box :id "card"
                                  :margin ((lh 1) (ch 2))
                                  :padding ((lh 1) (ch 2))
                                  :border ((px 1) solid "#888888")
                                  "Hello")))
    (ignore buffer)
    (let* ((card (car (ebox-selector-query root "#card")))
           (metrics (ebox-node-box-metrics card))
           (margin (plist-get metrics :margin))
           (border (plist-get metrics :border))
           (padding (plist-get metrics :padding))
           (bbox (plist-get metrics :border-box))
           (cbox (plist-get metrics :content-box)))
      (should metrics)
      (should (= (plist-get margin :top) 1))
      (should (= (plist-get margin :bottom) 1))
      (should (> (plist-get margin :left) 0))
      (should (= (plist-get border :top) 1))
      (should (= (plist-get border :bottom) 1))
      (should (> (plist-get border :left) 0))
      (should (= (plist-get padding :top) 1))
      (should (= (plist-get padding :bottom) 1))
      (should (> (plist-get padding :left) 0))
      (should (> (plist-get bbox :width) (plist-get cbox :width)))
      (should (> (plist-get bbox :height) (plist-get cbox :height))))
    (let ((unlaid (ebox-build '(box "detached"))))
      (should-not (ebox-node-box-metrics unlaid)))))

(ert-deftest ebox-node-inspect-style-reports-provenance-and-winners ()
  (let* ((scope (ebox-style-scope-create
                 '(("&.card" :padding ((lh 1) (ch 2)) :color "#ffffff")
                   ("&.other" :color "#00ff00"))))
         (tree (list 'column :width '(ch 40)
                     (list 'box :id "card" :class "card"
                           :ecss-scope-roots (list scope)
                           :ecss-scopes (list scope)
                           :color "#112233"
                           "Hello"))))
    (ebox-test-with-mounted (buffer root tree)
      (ignore buffer)
      (let* ((card (car (ebox-selector-query root "#card")))
             (info (ebox-node-inspect-style card))
             (vals (plist-get info :values))
             (rules (plist-get info :matched-rules))
             (inline-rule (cl-find-if (lambda (r) (plist-get r :inline)) rules))
             (scope-rule (cl-find-if (lambda (r) (equal (plist-get r :selector) "&.card")) rules))
             (other-rule (cl-find-if (lambda (r) (equal (plist-get r :selector) "&.other")) rules)))
        (should info)
        (should (equal (plist-get vals :color) "#112233"))
        (should inline-rule)
        (should scope-rule)
        (should-not other-rule)
        (let* ((inline-color (cl-find-if (lambda (d) (eq (plist-get d :property) :color))
                                         (plist-get inline-rule :declarations)))
               (scope-color (cl-find-if (lambda (d) (eq (plist-get d :property) :color))
                                        (plist-get scope-rule :declarations)))
               (scope-pad (cl-find-if (lambda (d) (eq (plist-get d :property) :padding-block-start))
                                      (plist-get scope-rule :declarations))))
          (should (plist-get inline-color :winner))
          (should-not (plist-get scope-color :winner))
          (should (plist-get scope-pad :winner)))))))

(ert-deftest ebox-node-row-spans-isolates-side-by-side-columns-and-clipping ()
  (ebox-test-with-mounted (buffer root
                           '(row :width (ch 40)
                             (box :id "left" :width (ch 18) "LeftA\nLeftB")
                             (box :id "right" :width (ch 18) "RightA\nRightB")))
    (let* ((left (car (ebox-selector-query root "#left")))
           (right (car (ebox-selector-query root "#right")))
           (lspans (ebox-node-row-spans left))
           (rspans (ebox-node-row-spans right)))
      (should (= (length lspans) 2))
      (should (= (length rspans) 2))
      (with-current-buffer buffer
        (let* ((l0 (car lspans))
               (r0 (car rspans))
               (ltext (buffer-substring-no-properties (cadr l0) (cddr l0)))
               (rtext (buffer-substring-no-properties (cadr r0) (cddr r0))))
          (should (= (car l0) (car r0)))
          (should (<= (cddr l0) (cadr r0)))
          (should (string-match-p "LeftA" ltext))
          (should-not (string-match-p "RightA" ltext))
          (should (string-match-p "RightA" rtext))
          (should-not (string-match-p "LeftA" rtext)))))))

(provide 'ebox-introspection-tests)
