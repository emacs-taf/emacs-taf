;;; etaf-web-adapter-docs.el --- Tier 2 universal docs-engine adapter -*- lexical-binding: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:
;;
;; Universal Tier 2 site-archetype adapter for technical documentation sites
;; generated by Starlight, VitePress, Docusaurus, MkDocs, Sphinx, mdBook,
;; GitBook, VuePress, Antora, Fumadocs, Nextra or Texinfo.
;;
;; Extracts the sidebar chapter tree, breadcrumb, optional language switch and
;; prev/next navigation from the fetched HTML DOM with zero extra network
;; requests.  Renders a full-height independently scrollable two-pane layout
;; with a draggable `etaf-pane-resizer' divider on wide viewports and folds
;; cleanly into an `etaf-drawer' on narrow or collapsed viewports.  Article
;; prose is rendered with embedded `etaf-ui-markdown' inside a single symmetric
;; centered reading column so breadcrumb, headings, code blocks and chapter
;; cards share one exact vertical grid.

;;; Code:

(require 'cl-lib)
(require 'dom)
(require 'subr-x)
(require 'url-parse)
(require 'etaf)
(require 'etaf-ui)
(require 'etaf-web-compile)
(require 'etaf-web-cache)
(require 'etaf-web-adapter)
(require 'etaf-web-router)
(require 'etaf-web-views)

(defconst etaf-web-docs--wide-breakpoint 104
  "Viewport width in columns at or above which the sidebar docks alongside text.")

(defconst etaf-web-docs--default-sidebar-cols 30
  "Default docked sidebar width in character columns.")

(defconst etaf-web-docs--min-sidebar-cols 20
  "Minimum docked sidebar width in character columns.")

(defconst etaf-web-docs--generator-patterns
  '(("starlight" . "Starlight")
    ("vitepress" . "VitePress")
    ("docusaurus" . "Docusaurus")
    ("mkdocs" . "MkDocs")
    ("sphinx" . "Sphinx")
    ("mdbook" . "mdBook")
    ("gitbook" . "GitBook")
    ("vuepress" . "VuePress")
    ("antora" . "Antora")
    ("fumadocs" . "Fumadocs")
    ("nextra" . "Nextra")
    ("texinfo" . "Texinfo")
    ("makeinfo" . "Texinfo"))
  "Alist mapping lowercased generator substrings to display engine names.")

(defconst etaf-web-docs--sidebar-class-regexp
  (concat
   "\\(?:\\`\\|[-_]\\)"
   "\\(?:sidebar\\|vpsidebar\\|sphinxsidebar\\|theme-doc-sidebar\\|wy-nav-side\\|"
   "md-sidebar\\|book-summary\\|docs-sidebar\\|sl-sidebar\\|doc-sidebar\\)"
   "\\(?:\\'\\|[-_]\\)")
  "Class/id pattern matching documentation primary navigation sidebars.")

(defconst etaf-web-docs--right-toc-regexp
  "right-sidebar\\|on-this-page\\|table-of-contents\\|page-toc\\|\\`toc\\'"
  "Class/id/aria pattern excluding right-hand in-page TOC panels.")

(defconst etaf-web-docs--sidebar-skip-classes
  '("md:sl-hidden" "sl-hidden" "mobile-preferences" "social-icons"
    "theme-toggle" "language-select" "sr-only" "visually-hidden"
    "screen-reader-text")
  "Classes inside sidebar containers holding utility chrome, not chapters.")

;;; ---------------------------------------------------------------------------
;;; Detection & sidebar tree extraction
;;; ---------------------------------------------------------------------------

(defun etaf-web-docs--detect-engine (dom)
  "Return matched documentation engine name from DOM `<meta generator>', or nil."
  (cl-loop for gen in (etaf-web--meta-generators dom)
           for low = (downcase gen)
           for hit = (cl-find-if (lambda (pair)
                                   (string-match-p (regexp-quote (car pair)) low))
                                 etaf-web-docs--generator-patterns)
           when hit return (cdr hit)))

(defun etaf-web-docs--same-host-p (u1 u2)
  "Return non-nil when HTTP(S) URLs U1 and U2 share the same host (or both file)."
  (let ((h1 (car (etaf-web--url-parts u1)))
        (h2 (car (etaf-web--url-parts u2))))
    (and (stringp h1) (stringp h2) (not (string-empty-p h1))
         (equal (downcase h1) (downcase h2)))))

(defun etaf-web-docs--normalize-doc-url (href base-url)
  "Resolve HREF against BASE-URL for docs navigation, dropping `#fragment'."
  (when-let* ((resolved (etaf-web--resolve-url href base-url)))
    (unless (string-prefix-p "#" resolved)
      (let ((hash (string-match "#" resolved)))
        (etaf-web--normalize-url
         (if hash (substring resolved 0 hash) resolved))))))

(defconst etaf-web-docs--framework-sidebar-class-regexp
  (concat
   "\\(?:\\`\\|[-_]\\)"
   "\\(?:vpsidebar\\|sphinxsidebar\\|theme-doc-sidebar\\|wy-nav-side\\|"
   "md-sidebar\\|book-summary\\|docs-sidebar\\|sl-sidebar\\|"
   "doc-sidebar\\|td-sidebar\\|nextra-sidebar\\|nd-docs-layout\\)"
   "\\(?:\\'\\|[-_]\\)")
  "Class/id pattern matching explicit documentation-framework sidebars.")

(defconst etaf-web-docs--non-docs-nav-regexp
  (concat "drawer-menu-overlay\\|wp-block-template-part\\|mobile-menu\\|"
          "site-nav\\|global-nav\\|header-nav\\|main-navigation\\|main-nav")
  "Class/id pattern excluding global site/drawer navigation chrome.")

(defun etaf-web-docs--framework-sidebar-p (node)
  "Return non-nil when DOM NODE carries an explicit docs-framework sidebar token."
  (when (etaf-web--node-p node)
    (let ((id (downcase (or (etaf-web--attr node 'id) ""))))
      (or (string-match-p etaf-web-docs--framework-sidebar-class-regexp id)
          (cl-some (lambda (tok)
                     (string-match-p etaf-web-docs--framework-sidebar-class-regexp tok))
                   (etaf-web--class-tokens node))))))

(defun etaf-web-docs--docs-url-signal-p (url)
  "Return non-nil when URL host or path structurally indicates documentation."
  (let* ((parsed (ignore-errors (url-generic-parse-url url)))
         (host (downcase (or (and parsed (url-host parsed)) "")))
         (path (downcase (or (and parsed (car (url-path-and-query parsed))) ""))))
    (or (string-match-p
         "\\`\\(?:docs\\|doc\\|developer\\|developers\\|learn\\|manual\\|wiki\\|guide\\)\\."
         host)
        (string-match-p
         "/\\(?:docs\\|doc\\|guide\\|guides\\|wiki\\|learn\\|manual\\|handbook\\|reference\\|api\\|library\\|views\\|workers\\|runtime\\|concepts\\|tutorial\\|book\\)\\(?:/\\|\\'\\)"
         path))))

(defun etaf-web-docs--sidebar-candidate-p (node)
  "Return non-nil when DOM NODE looks like a primary documentation sidebar."
  (when (and (etaf-web--node-p node)
             (memq (dom-tag node) '(nav aside div)))
    (let* ((tokens (etaf-web--class-tokens node))
           (cls (downcase (or (etaf-web--attr node 'class) "")))
           (id (downcase (or (etaf-web--attr node 'id) "")))
           (aria (downcase (or (etaf-web--attr node 'aria-label) "")))
           (combined (concat cls " " id " " aria))
           (tag (dom-tag node))
           (token-hit (or (string-match-p etaf-web-docs--sidebar-class-regexp id)
                          (cl-some (lambda (tok)
                                     (string-match-p etaf-web-docs--sidebar-class-regexp tok))
                                   tokens)))
           (div-has-nav (or (not (eq tag 'div))
                            (and (not (string-match-p "project-description" combined))
                                 (etaf-web--find-first
                                  node (lambda (n) (memq (dom-tag n) '(nav ul ol details))))))))
      (and (not (string-match-p etaf-web-docs--right-toc-regexp combined))
           (not (string-match-p etaf-web-docs--non-docs-nav-regexp combined))
           div-has-nav
           (or token-hit
               (and (eq tag 'nav)
                    (string-match-p
                     "sidebar\\|docs\\|manual\\|guide\\|documentation\\|chapters"
                     aria)))))))

(defun etaf-web-docs--language-link-p (node)
  "Return non-nil when DOM anchor NODE is a site locale/language switch link."
  (when (and (etaf-web--node-p node) (eq (dom-tag node) 'a))
    (let ((classes (etaf-web--class-list node))
          (hreflang (etaf-web--attr node 'hreflang)))
      (or (and (stringp hreflang) (not (string-empty-p (string-trim hreflang))))
          (cl-some (lambda (c)
                     (member c '("language-link" "lang-link" "locale-link")))
                   classes)))))

(defun etaf-web-docs--skip-utility-node-p (node)
  "Return non-nil when DOM NODE is non-chapter utility chrome inside a sidebar."
  (when (etaf-web--node-p node)
    (let ((classes (etaf-web--class-list node)))
      (or (equal (downcase (or (etaf-web--attr node 'aria-hidden) "")) "true")
          (cl-some (lambda (c) (member c etaf-web-docs--sidebar-skip-classes))
                   classes)))))

(defun etaf-web-docs--extract-lang-switch (sidebar base-url)
  "Extract optional language-switch plist `(:label :url)' from SIDEBAR, or nil."
  (when-let* ((a (etaf-web--find-first sidebar #'etaf-web-docs--language-link-p))
              (norm (etaf-web-docs--normalize-doc-url (etaf-web--attr a 'href) base-url))
              (lbl (etaf-web--clean-text a)))
    (when (and (not (string-empty-p lbl))
               (etaf-web-docs--same-host-p norm base-url)
               (not (equal norm (etaf-web--normalize-url base-url))))
      (list :label lbl :url norm))))

(defun etaf-web-docs--count-internal-links (node base-url)
  "Count distinct same-host chapter links inside DOM NODE relative to BASE-URL."
  (let ((seen (make-hash-table :test #'equal)))
    (dolist (a (etaf-web--find-all node (lambda (n) (eq (dom-tag n) 'a))))
      (unless (etaf-web-docs--language-link-p a)
        (when-let* ((norm (etaf-web-docs--normalize-doc-url
                           (etaf-web--attr a 'href) base-url))
                    (txt (etaf-web--clean-text a)))
          (when (and (not (string-empty-p txt))
                     (etaf-web-docs--same-host-p norm base-url)
                     (not (string-match-p "/search\\b.*[?]" norm)))
            (puthash norm t seen)))))
    (hash-table-count seen)))

(defun etaf-web-docs--structural-sidebar-p (node base-url)
  "Return non-nil when DOM NODE is a structural docs sidebar outside main prose.
Recognizes `<aside>' or `<nav>' panels that lack framework-specific `sidebar'
classes (e.g. hand-crafted or utility-CSS docs/wikis) when they hold a
multi-group chapter tree (`>= 2' `<details>' or `<ul>'/`<ol>' groups) with at
least 8 distinct same-host page links."
  (when (and (etaf-web--node-p node)
             (memq (dom-tag node) '(aside nav)))
    (let* ((cls (downcase (or (etaf-web--attr node 'class) "")))
           (id (downcase (or (etaf-web--attr node 'id) "")))
           (aria (downcase (or (etaf-web--attr node 'aria-label) "")))
           (combined (concat cls " " id " " aria)))
      (when (not (string-match-p etaf-web-docs--right-toc-regexp combined))
        (let ((groups (length (etaf-web--find-all
                               node (lambda (n)
                                      (memq (dom-tag n) '(details ul ol)))))))
          (and (>= groups 2)
               (>= (etaf-web-docs--count-internal-links node base-url) 8)))))))

(defun etaf-web-docs--find-structural-sidebars (dom base-url)
  "Collect structural sidebar `<aside>'/`<nav>' nodes in DOM for BASE-URL.
Excludes nodes nested inside `<header>', `<footer>', `<main>' or `<article>'."
  (when (etaf-web--find-first dom (lambda (n) (memq (dom-tag n) '(main article))))
    (let ((acc nil))
      (cl-labels
          ((walk (n)
             (when (etaf-web--node-p n)
               (let ((tag (dom-tag n)))
                 (cond
                  ((memq tag '(header footer main article)) nil)
                  ((etaf-web-docs--structural-sidebar-p n base-url)
                   (push n acc))
                  (t (dolist (c (dom-children n)) (walk c))))))))
        (walk dom))
      (nreverse acc))))

(defun etaf-web-docs--find-class-sidebars (dom)
  "Collect class/aria sidebar candidates in DOM outside `<header>' and `<footer>'."
  (let ((acc nil))
    (cl-labels
        ((walk (n)
           (when (etaf-web--node-p n)
             (let ((tag (dom-tag n)))
               (cond
                ((memq tag '(header footer)) nil)
                ((etaf-web-docs--sidebar-candidate-p n)
                 (push n acc)
                 (dolist (c (dom-children n)) (walk c)))
                (t (dolist (c (dom-children n)) (walk c))))))))
      (walk dom))
    (nreverse acc)))

(defun etaf-web-docs--find-sidebar (dom base-url)
  "Return the best primary sidebar DOM element in DOM for BASE-URL, or nil."
  (let ((best nil)
        (best-score 0)
        (candidates (or (etaf-web-docs--find-class-sidebars dom)
                        (etaf-web-docs--find-structural-sidebars dom base-url))))
    (dolist (cand candidates)
      (let* ((count (etaf-web-docs--count-internal-links cand base-url))
             (tag-bonus (if (memq (dom-tag cand) '(nav aside)) 4 0))
             (fw-bonus (if (etaf-web-docs--framework-sidebar-p cand) 20 0))
             (score (+ count tag-bonus fw-bonus)))
        (when (and (>= count 4) (> score best-score))
          (setq best cand best-score score))))
    best))

(defun etaf-web-docs--extract-tree (sidebar base-url)
  "Extract chapter tree and metadata from SIDEBAR relative to BASE-URL.
Preserves full untruncated labels so live sidebar resizing reveals titles
without loss, and excludes mobile utility/language chrome from chapters."
  (let ((counter 0)
        (key-to-url (make-hash-table :test #'equal))
        (seen-urls (make-hash-table :test #'equal))
        (leaves nil)
        (cur-norm (etaf-web--normalize-url base-url))
        (active-key nil)
        (active-ancestry nil)
        (lang-switch (etaf-web-docs--extract-lang-switch sidebar base-url)))
    (cl-labels
        ((next-key ()
           (setq counter (1+ counter))
           (format "doc-%d" counter))
         (direct-label (node)
           (let ((parts nil))
             (dolist (c (dom-children node))
               (cond
                ((stringp c)
                 (let ((s (string-trim (etaf-web--collapse-ws c))))
                   (unless (string-empty-p s) (push s parts))))
                ((and (etaf-web--node-p c)
                      (not (etaf-web-docs--skip-utility-node-p c))
                      (memq (dom-tag c) '(span strong b p h2 h3 h4 h5 label summary a))
                      (not (etaf-web--find-first c (lambda (x) (memq (dom-tag x) '(ul ol))))))
                 (let ((s (etaf-web--clean-text c)))
                   (unless (string-empty-p s) (push s parts))))))
             (string-trim (mapconcat #'identity (nreverse parts) " "))))
         (make-leaf (label norm ancestry)
           (unless (or (string-empty-p label)
                       (gethash norm seen-urls)
                       (not (etaf-web-docs--same-host-p norm base-url)))
             (puthash norm t seen-urls)
             (let* ((key (next-key))
                    (is-active (equal norm cur-norm)))
               (puthash key norm key-to-url)
               (push (list :key key :label label :url norm :ancestry ancestry) leaves)
               (when is-active
                 (setq active-key key
                       active-ancestry ancestry))
               (list :key key :label label))))
         (walk-list (nodes ancestry)
           (let ((out nil))
             (dolist (n nodes)
               (when (and (etaf-web--node-p n)
                          (not (etaf-web-docs--skip-utility-node-p n)))
                 (let ((tag (dom-tag n)))
                   (cond
                    ((eq tag 'details)
                     (let* ((sum (cl-find-if (lambda (c)
                                               (and (etaf-web--node-p c)
                                                    (eq (dom-tag c) 'summary)))
                                             (dom-children n)))
                            (title (if sum
                                       (let ((dl (direct-label sum)))
                                         (if (string-empty-p dl)
                                             (etaf-web--clean-text sum)
                                           dl))
                                     ""))
                            (rest (cl-remove sum (dom-children n) :count 1 :test #'eq))
                            (gkey (next-key))
                            (kids (walk-list rest (cons (cons gkey title) ancestry))))
                       (cond
                        ((and (not (string-empty-p title)) kids)
                         (push (list :key gkey :label title :children kids) out))
                        (kids (setq out (append (nreverse kids) out))))))
                    ((eq tag 'section)
                     ;; Section groups (e.g. VitePress VPSidebarItem) pairing a
                     ;; heading (`h2'-`h5') with a nested list of chapter links.
                     (let* ((sublists (cl-remove-if-not
                                       (lambda (c)
                                         (and (etaf-web--node-p c)
                                              (memq (dom-tag c) '(ul ol details nav))))
                                       (dom-children n)))
                            (heading-node
                             (and sublists
                                  (cl-loop for c in (dom-children n)
                                           when (and (etaf-web--node-p c)
                                                     (not (memq c sublists)))
                                           for h = (etaf-web--find-first
                                                    c (lambda (x)
                                                        (memq (dom-tag x) '(h2 h3 h4 h5))))
                                           when h return h)))
                            (title (and heading-node (etaf-web--clean-text heading-node))))
                       (if (and title (not (string-empty-p title)) sublists)
                           (let* ((gkey (next-key))
                                  (kids (walk-list sublists (cons (cons gkey title) ancestry))))
                             (cond
                              (kids (push (list :key gkey :label title :children kids) out))))
                         (let ((kids (walk-list (dom-children n) ancestry)))
                           (setq out (append (nreverse kids) out))))))
                    ((memq tag '(ul ol))
                     (let ((kids (walk-list (dom-children n) ancestry)))
                       (setq out (append (nreverse kids) out))))
                    ((eq tag 'li)
                     (let* ((sublists
                             (cl-loop for c in (dom-children n)
                                      when (and (etaf-web--node-p c)
                                                (not (etaf-web-docs--skip-utility-node-p c)))
                                      append
                                      (cond
                                       ((memq (dom-tag c) '(ul ol details)) (list c))
                                       ((and (memq (dom-tag c) '(nav div))
                                             (etaf-web--find-first
                                              c (lambda (x)
                                                  (memq (dom-tag x) '(ul ol details)))))
                                        (list c))
                                       (t nil))))
                            (first-a (cl-find-if (lambda (c)
                                                   (and (etaf-web--node-p c)
                                                        (eq (dom-tag c) 'a)
                                                        (not (etaf-web-docs--language-link-p c))))
                                                 (dom-children n)))
                            (all-as (unless sublists
                                      (etaf-web--find-all
                                       n (lambda (x)
                                           (and (eq (dom-tag x) 'a)
                                                (not (etaf-web-docs--language-link-p x)))))))
                            (nested-a (or first-a (car all-as))))
                       (cond
                        (sublists
                         (let* ((title (direct-label n))
                                (gkey (next-key))
                                (next-anc (if (string-empty-p title)
                                              ancestry
                                            (cons (cons gkey title) ancestry)))
                                (self-leaf
                                 (when first-a
                                   (when-let* ((norm (etaf-web-docs--normalize-doc-url
                                                      (etaf-web--attr first-a 'href) base-url))
                                               (lbl (etaf-web--clean-text first-a)))
                                     (make-leaf lbl norm next-anc))))
                                (kids (walk-list sublists next-anc))
                                (all-kids (if self-leaf (cons self-leaf kids) kids)))
                           (cond
                            ((and (not (string-empty-p title)) all-kids)
                             (push (list :key gkey :label title :children all-kids) out))
                            (all-kids (setq out (append (nreverse all-kids) out))))))
                        ((> (length all-as) 1)
                         ;; Single `<li>' wrapping multiple chapter links (e.g. VitePress).
                         (let ((kids (walk-list (dom-children n) ancestry)))
                           (setq out (append (nreverse kids) out))))
                        (nested-a
                         (when-let* ((norm (etaf-web-docs--normalize-doc-url
                                            (etaf-web--attr nested-a 'href) base-url))
                                     (lbl (etaf-web--clean-text nested-a))
                                     (leaf (make-leaf lbl norm ancestry)))
                           (push leaf out))))))
                    ((eq tag 'a)
                     (unless (etaf-web-docs--language-link-p n)
                       (when-let* ((norm (etaf-web-docs--normalize-doc-url
                                          (etaf-web--attr n 'href) base-url))
                                   (dl (direct-label n))
                                   (lbl (if (string-empty-p dl)
                                            (etaf-web--clean-text n)
                                          dl))
                                   (leaf (make-leaf lbl norm ancestry)))
                         (push leaf out))))
                    ((memq tag '(script style svg template noscript button input select form))
                     nil)
                    (t
                     (let ((kids (walk-list (dom-children n) ancestry)))
                       (setq out (append (nreverse kids) out))))))))
             (nreverse out))))
      (let* ((items (walk-list (dom-children sidebar) nil))
             (ordered-leaves (nreverse leaves))
             (expanded (delq nil (mapcar #'car active-ancestry)))
             (breadcrumb (nreverse (delq nil (mapcar #'cdr active-ancestry)))))
        ;; Expand the first branch by default when no active page matched yet.
        (when (and (null expanded) items (plist-get (car items) :children))
          (setq expanded (list (plist-get (car items) :key))))
        (list :items items
              :key-to-url key-to-url
              :leaves ordered-leaves
              :active-key active-key
              :expanded expanded
              :breadcrumb breadcrumb
              :lang-switch lang-switch)))))

(defun etaf-web-docs--resolve-prev-next (dom leaves active-key base-url)
  "Return `(PREV . NEXT)' chapter plists `(:label :url)' from DOM or LEAVES."
  (let ((prev nil)
        (next nil))
    (dolist (a (etaf-web--find-all
                dom (lambda (n)
                      (and (memq (dom-tag n) '(a link))
                           (member (downcase (or (etaf-web--attr n 'rel) ""))
                                   '("prev" "previous" "next"))))))
      (let* ((rel (downcase (or (etaf-web--attr a 'rel) "")))
             (norm (etaf-web-docs--normalize-doc-url (etaf-web--attr a 'href) base-url))
             (raw-lbl (or (let ((t1 (etaf-web--clean-text a)))
                            (and (not (string-empty-p t1)) t1))
                          (etaf-web--attr a 'title)))
             (lbl (and raw-lbl
                       (string-trim
                        (replace-regexp-in-string
                         "\\`\\(?:Previous\\|Next\\|上一页\\|下一页\\|上一章\\|下一章\\)[[:space:]:：·-]+\\(.+\\)\\'"
                         "\\1" raw-lbl)))))
        (when (and norm (etaf-web-docs--same-host-p norm base-url))
          (cond
           ((and (member rel '("prev" "previous")) (not prev))
            (setq prev (list :label (or lbl "上一章") :url norm)))
           ((and (equal rel "next") (not next))
            (setq next (list :label (or lbl "下一章") :url norm)))))))
    ;; Fall back to adjacent leaves in the extracted sidebar tree.
    (when (and active-key (or (null prev) (null next)))
      (let ((idx (cl-position active-key leaves
                              :key (lambda (l) (plist-get l :key))
                              :test #'equal)))
        (when idx
          (when (and (null prev) (> idx 0))
            (let ((p (nth (1- idx) leaves)))
              (setq prev (list :label (plist-get p :label)
                               :url (plist-get p :url)))))
          (when (and (null next) (< (1+ idx) (length leaves)))
            (let ((n (nth (1+ idx) leaves)))
              (setq next (list :label (plist-get n :label)
                               :url (plist-get n :url))))))))
    (cons prev next)))

(defun etaf-web-docs--match-html-p (url _headers _html dom)
  "Return non-nil when DOM is a documentation page with a sidebar chapter tree."
  (when (and dom (etaf-web--http-url-p url))
    (let* ((engine (etaf-web-docs--detect-engine dom))
           (sidebar (etaf-web-docs--find-sidebar dom url)))
      (and sidebar
           (or engine
               (and (>= (etaf-web-docs--count-internal-links sidebar url) 5)
                    (or (etaf-web-docs--framework-sidebar-p sidebar)
                        (etaf-web-docs--docs-url-signal-p url)
                        (let ((tr (etaf-web-docs--extract-tree sidebar url)))
                          (and (plist-get tr :active)
                               (>= (length (plist-get tr :leaves)) 6))))))))))

;;; ---------------------------------------------------------------------------
;;; Tree filtering & dedicated chapter tree view (v2)
;;; ---------------------------------------------------------------------------

(defun etaf-web-docs--filter-tree-items (items query)
  "Filter nested docs tree ITEMS by case-insensitive substring QUERY."
  (let ((q (downcase (string-trim (or query "")))))
    (if (string-empty-p q)
        items
      (cl-labels
          ((walk (nodes)
             (delq
              nil
              (mapcar
               (lambda (item)
                 (let* ((lbl (downcase (or (plist-get item :label) "")))
                        (kids (plist-get item :children))
                        (matched-self (string-match-p (regexp-quote q) lbl)))
                   (if kids
                       (let ((filtered-kids (if matched-self kids (walk kids))))
                         (when filtered-kids
                           (list :key (plist-get item :key)
                                 :label (plist-get item :label)
                                 :children filtered-kids)))
                     (when matched-self item))))
               nodes))))
        (walk items)))))

(defun etaf-web-docs--all-branch-keys (items)
  "Return list of all branch `:key' values in nested docs tree ITEMS."
  (let ((acc nil))
    (cl-labels ((walk (nodes)
                  (dolist (it nodes)
                    (when-let* ((kids (plist-get it :children)))
                      (push (plist-get it :key) acc)
                      (walk kids)))))
      (walk items))
    (nreverse acc)))

(defun etaf-web-docs--flatten-tree (items expanded)
  "Flatten visible tree ITEMS under EXPANDED keys into row descriptors."
  (let ((rows nil))
    (cl-labels
        ((walk (nodes depth)
           (dolist (it nodes)
             (let* ((key (plist-get it :key))
                    (kids (plist-get it :children))
                    (open (and kids (member key expanded))))
               (push (list :key key
                           :label (plist-get it :label)
                           :depth depth
                           :branch (and kids t)
                           :open (and open t))
                     rows)
               (when open
                 (walk kids (1+ depth)))))))
      (walk items 0))
    (nreverse rows)))

(defun etaf-web-docs--border (key fallback &optional px)
  "Build solid Theme border token of PX pixels for KEY."
  (let ((w (or px 1)))
    (etaf-theme-token key fallback (lambda (c) (list (list 'px w) 'solid c)))))

(defun etaf-web-docs--render-tree-rows (items expanded active-key panel-cols
                                              on-toggle on-select)
  "Render visible chapter rows for ITEMS fitting live PANEL-COLS.
Highlights ONLY the active chapter leaf (never expanded branch headers) and
truncates dynamically with ellipsis when a title exceeds PANEL-COLS."
  (let* ((rows (etaf-web-docs--flatten-tree items expanded))
         (fg-tok (etaf-theme-token :ui-fg "#d8e1e6"))
         (muted-tok (etaf-theme-token :ui-muted-fg "#8496a0"))
         (dim-tok (etaf-theme-token :ui-disabled-fg "#5c6e78"))
         (accent-tok (etaf-theme-token :ui-accent "#63c5da"))
         (sel-bg (etaf-theme-token :web-selected-bg "#eef5fc"))
         (hover-bg (etaf-theme-token :web-hover-bg "#f4f7fa"))
         (accent-bar (etaf-web-docs--border :ui-accent "#63c5da" 2)))
    (etaf-node
     'column (list :width 'stretch :item-gap '(lh 0) :focus-group 'vertical)
     (mapcar
      (lambda (entry)
        (let* ((key (plist-get entry :key))
               (raw-label (or (plist-get entry :label) ""))
               (depth (or (plist-get entry :depth) 0))
               (branch (plist-get entry :branch))
               (open (plist-get entry :open))
               (active (and (not branch) active-key (equal key active-key)))
               (indent (+ 1 (* 2 depth) (if branch 0 2)))
               (budget (max 8 (- panel-cols indent (if branch 6 4))))
               (disp (if (> (string-width raw-label) budget)
                         (truncate-string-to-width raw-label budget 0 nil "…")
                       raw-label))
               (toggle (lambda ()
                         (funcall on-toggle
                                  (if open
                                      (delete key (copy-sequence expanded))
                                    (cons key (copy-sequence expanded)))))))
          (if branch
              (etaf-node
               'flex
               (list :key key
                     :width 'stretch
                     :height '(lh 1)
                     :align-items 'center
                     :padding-left (list 'ch (+ 1 (* 2 depth)))
                     :padding-right '(ch 1)
                     :hover-style (list :background-color hover-bg)
                     :role 'button :tab-index 0 :pointer 'hand
                     :aria-label raw-label
                     :aria-expanded (if open t 'false)
                     :help-echo raw-label
                     :on-direction (lambda (dir)
                                     (pcase dir
                                       ('right (if open 'release
                                                 (funcall toggle) 'handled))
                                       ('left (if open (progn (funcall toggle) 'handled)
                                                'release))
                                       (_ 'release)))
                     :on-press toggle)
               (list
                (etaf-node 'box (list :width '(ch 2) :flex-shrink 0)
                           (list (etaf-node 'text
                                            (list :color (if open accent-tok dim-tok))
                                            (list (if open "▾" "▸")))))
                (etaf-node 'box (list :flex-grow 1 :flex-basis '(ch 0)
                                      :min-width '(ch 0) :overflow 'hidden)
                           (list (etaf-node 'text
                                            (list :color (if open fg-tok muted-tok)
                                                  :font-weight (if open 'bold 'normal))
                                            (list disp))))))
            (etaf-node
             'flex
             (append
              (list :key key
                    :width 'stretch
                    :height '(lh 1)
                    :align-items 'center
                    :padding-left (list 'ch indent)
                    :padding-right '(ch 1)
                    :role 'button :tab-index 0 :pointer 'hand
                    :aria-label raw-label
                    :help-echo raw-label
                    :on-press (lambda () (funcall on-select key)))
              (if active
                  (list :background-color sel-bg
                        :border-left accent-bar
                        :aria-selected t)
                (list :hover-style (list :background-color hover-bg))))
             (list
              (etaf-node 'box (list :flex-grow 1 :flex-basis '(ch 0)
                                    :min-width '(ch 0) :overflow 'hidden)
                         (list (etaf-node 'text
                                          (list :color (if active accent-tok muted-tok)
                                                :font-weight (if active 'bold 'normal))
                                          (list disp)))))))))
      rows))))

(defun etaf-web-docs--render-sidebar-panel (st panel-cols in-drawer)
  "Render sidebar/drawer header, ordinary flat filter, scrollable tree & footer."
  (let* ((items (plist-get st :tree-items))
         (active-key (plist-get st :active-key))
         (leaves (plist-get st :leaves))
         (lang-switch (plist-get st :lang-switch))
         (filter-ref (plist-get st :filter-ref))
         (query (etaf-value filter-ref))
         (filtered (etaf-web-docs--filter-tree-items items query))
         (expanded-ref (plist-get st :expanded-ref))
         (expanded (if (and (stringp query) (not (string-empty-p (string-trim query))))
                       (etaf-web-docs--all-branch-keys filtered)
                     (etaf-value expanded-ref)))
         (on-select (plist-get st :on-select))
         (on-toggle-sidebar (plist-get st :on-toggle-sidebar))
         (navigate (plist-get st :navigate))
         (fg-tok (etaf-theme-token :ui-fg "#d8e1e6"))
         (dim-tok (etaf-theme-token :ui-disabled-fg "#5c6e78"))
         (accent-tok (etaf-theme-token :ui-accent "#63c5da"))
         (hover-bg (etaf-theme-token :web-hover-bg "#f4f7fa"))
         (on-toggle (lambda (next) (etaf-set-value expanded-ref next)))
         (tree-body
          (if filtered
              (etaf-web-docs--render-tree-rows
               filtered expanded active-key panel-cols on-toggle on-select)
            (etaf-node 'box (list :width 'stretch :padding '((lh 1) (ch 1)))
                       (list (etaf-view
                              (etaf-empty :title "无匹配章节"
                                          :description "清空关键字查看全部目录。")))))))
    (etaf-node
     'flex (list :flex-direction 'column
                 :width 'stretch
                 :height (if in-drawer 'auto 'stretch)
                 :min-height '(lh 0)
                 :overflow (if in-drawer 'visible 'hidden))
     (delq
      nil
      (list
       ;; Fixed top header + ordinary 1-row outlined filter input (2ch inset)
       (etaf-node
        'column (append
                 (list :width 'stretch :flex-shrink 0 :item-gap '(lh 1))
                 (if in-drawer
                     (list :padding-bottom '(lh 1))
                   (list :padding-top '(lh 1)
                         :padding-bottom '(lh 0.5)
                         :padding-left '(ch 2)
                         :padding-right '(ch 2))))
        (delq
         nil
         (list
          (unless in-drawer
            (etaf-node
             'flex (list :width 'stretch :align-items 'center
                         :justify-content 'space-between)
             (list
              (etaf-node 'text (list :font-weight 'bold :color fg-tok)
                         (list "目录"))
              (etaf-node 'box (list :flex-shrink 0
                                    :hover-style (list :background-color hover-bg))
                         (list (etaf-ui-icon 'sidebar :set 'svg :min-width 2
                                             :color dim-tok
                                             :aria-label "折叠目录"
                                             :help-echo "折叠文档目录 (s)"
                                             :on-press on-toggle-sidebar))))))
          (etaf-web--plain-input-view
           :bind filter-ref
           :ref (if in-drawer 'docs-drawer-filter 'docs-sidebar-filter)
           :label "筛选章节"
           :icon 'search
           :placeholder "筛选章节…"
           :width 'stretch))))
       ;; Independently scrollable chapter tree (1ch inset + 1ch inner = 2ch axis)
       (if in-drawer
           (etaf-node 'box (list :width 'stretch
                                 :padding-left '(ch 1) :padding-right '(ch 1))
                      (list tree-body))
         (etaf-node
          'box (list :ref 'docs-sidebar-scroll
                     :width 'stretch
                     :flex-grow 1
                     :flex-basis '(lh 0)
                     :min-height '(lh 0)
                     :overflow 'scroll
                     :role 'region
                     :tab-index 0
                     :aria-label "文档目录列表")
          (list (etaf-node 'column (list :width 'stretch :height 'auto
                                         :padding-left '(ch 1)
                                         :padding-right '(ch 1)
                                         :padding-bottom '(lh 1))
                           (list tree-body)))))
       ;; Quiet borderless sidebar footer
       (unless in-drawer
         (etaf-node
          'flex (list :width 'stretch :flex-shrink 0
                      :align-items 'center :justify-content 'space-between
                      :padding-top '(lh 0.5)
                      :padding-bottom '(lh 0.5)
                      :padding-left '(ch 2)
                      :padding-right '(ch 2))
          (delq
           nil
           (list
            (if lang-switch
                (let ((lurl (plist-get lang-switch :url))
                      (llbl (plist-get lang-switch :label)))
                  (etaf-node
                   'flex (list :align-items 'center :column-gap '(ch 1) :flex-shrink 0)
                   (list
                    (etaf-node 'text (list :color dim-tok) (list "语言"))
                    (etaf-view
                     (etaf-button :label llbl
                                  :variant 'ghost
                                  :color accent-tok
                                  :padding '((lh 0) (ch 0))
                                  :aria-label (format "切换语言 %s" llbl)
                                  :help-echo lurl
                                  :on-press (lambda () (funcall navigate lurl)))))))
              (etaf-node 'text (list :color dim-tok)
                         (list (format "共 %d 章" (length leaves)))))
            (when (>= panel-cols 22)
              (etaf-node 'text (list :color dim-tok) (list "[ / ] 调宽"))))))))))))

(defun etaf-web-docs--render-prev-next (prev next narrow navigate)
  "Render bottom Prev/Next chapter cards aligned to the reading column."
  (when (or prev next)
    (let ((fg-tok (etaf-theme-token :ui-fg "#d8e1e6"))
          (muted-tok (etaf-theme-token :ui-muted-fg "#8496a0"))
          (accent-tok (etaf-theme-token :ui-accent "#63c5da"))
          (panel-bg (etaf-theme-token :web-sidebar-bg "#f7f9fb"))
          (hover-bg (etaf-theme-token :web-hover-bg "#f4f7fa"))
          (border (etaf-web-docs--border :ui-border "#36444c" 1)))
      (etaf-node
       'flex (list :width 'stretch :column-gap '(ch 2) :row-gap '(lh 1)
                   :flex-wrap (if narrow 'wrap 'nowrap))
       (delq
        nil
        (list
         (when prev
           (let ((purl (plist-get prev :url))
                 (plbl (plist-get prev :label)))
             (etaf-node
              'column
              (list :flex-grow 1 :flex-basis '(ch 0) :min-width '(ch 22)
                    :padding '((lh 0) (ch 2))
                    :background-color panel-bg
                    :border border
                    :hover-style (list :background-color hover-bg)
                    :role 'button :tab-index 0 :pointer 'hand
                    :ref 'docs-prev-chapter
                    :aria-label (format "上一章 %s" plbl)
                    :on-press (lambda () (funcall navigate purl)))
              (list
               (etaf-node 'text (list :color muted-tok) (list "← 上一章 (H)"))
               (etaf-node 'text (list :font-weight 'bold :color fg-tok)
                          (list plbl))))))
         (when next
           (let ((nurl (plist-get next :url))
                 (nlbl (plist-get next :label)))
             (etaf-node
              'column
              (list :flex-grow 1 :flex-basis '(ch 0) :min-width '(ch 22)
                    :cross-align 'end
                    :padding '((lh 0) (ch 2))
                    :background-color panel-bg
                    :border border
                    :hover-style (list :background-color hover-bg)
                    :role 'button :tab-index 0 :pointer 'hand
                    :ref 'docs-next-chapter
                    :aria-label (format "下一章 %s" nlbl)
                    :on-press (lambda () (funcall navigate nurl)))
              (list
               (etaf-node 'text (list :color muted-tok)
                          (list "下一章 (L) →"))
               (etaf-node 'text (list :font-weight 'bold :color accent-tok)
                          (list nlbl))))))))))))

(defun etaf-web-docs--render-article-pane (st right-cols narrow dock-sidebar theme)
  "Render independently scrollable right article pane with symmetric grid."
  (let* ((_media-rev (etaf-value (plist-get st :media-rev)))
         (doc (plist-get st :doc))
         (page-dir (plist-get st :page-dir))
         (open-link (plist-get st :open-link))
         (title (plist-get st :title))
         (breadcrumb (plist-get st :breadcrumb))
         (prev (plist-get st :prev))
         (next (plist-get st :next))
         (navigate (plist-get st :navigate))
         (on-open-drawer (plist-get st :on-open-drawer))
         (on-toggle-sidebar (plist-get st :on-toggle-sidebar))
         (measure-cap (or (etaf-value (plist-get st :measure-ref)) 84))
         (pad-h (if narrow 1 3))
         (avail (max 32 (- right-cols (* 2 pad-h))))
         (content-cols (min measure-cap avail))
         (muted-tok (etaf-theme-token :ui-muted-fg "#8496a0"))
         (dim-tok (etaf-theme-token :ui-disabled-fg "#5c6e78"))
         (accent-tok (etaf-theme-token :ui-accent "#63c5da"))
         (crumb-line (mapconcat #'identity
                                (append breadcrumb (when title (list title)))
                                "  /  ")))
    (etaf-node
     'box
     (list :key 'docs-article-pane
           :ref 'web-scroll :id "web-scroll"
           :width '(ch 0)
           :flex-grow 1
           :flex-basis '(ch 0)
           :min-width '(ch 0)
           :height 'stretch
           :min-height '(lh 0)
           :overflow 'scroll
           :role 'region
           :tab-index 0
           :aria-label "文档正文"
           :region (if dock-sidebar
                       '(:id docs-body :label "文档正文" :key "v"
                             :neighbors (:left docs-sidebar))
                     '(:id docs-body :label "文档正文" :key "v")))
     (list
      (etaf-node
       'column
       (list :width 'stretch
             :height 'auto
             :cross-align 'center
             :padding (list (list 'lh 1) (list 'ch pad-h)))
       (list
        ;; Single unified reading column: breadcrumb, title, body, prev/next
        ;; all share the exact same left & right edges with symmetric margins.
        (etaf-node
         'column
         (list :width (list 'ch content-cols)
               :item-gap '(lh 1))
         (delq
          nil
          (list
           ;; Breadcrumb row (merges `≡ 目录' inline when collapsed or narrow)
           (when (or (not dock-sidebar)
                     (and (stringp crumb-line) (not (string-empty-p crumb-line))))
             (etaf-node
              'flex (list :width 'stretch :align-items 'center
                          :column-gap '(ch 1) :row-gap '(lh 0) :flex-wrap 'wrap)
              (delq
               nil
               (list
                (unless dock-sidebar
                  (etaf-view
                   (etaf-button
                    :label "≡ 目录"
                    :variant 'ghost
                    :ref 'docs-drawer-trigger
                    :color accent-tok
                    :padding '((lh 0) (ch 1))
                    :help-echo "打开文档目录 (s)"
                    :on-press (if narrow on-open-drawer on-toggle-sidebar))))
                (when (and (not dock-sidebar)
                           (stringp crumb-line) (not (string-empty-p crumb-line)))
                  (etaf-node 'text (list :color dim-tok) (list "│")))
                (when (and (stringp crumb-line) (not (string-empty-p crumb-line)))
                  (etaf-node 'text (list :color muted-tok) (list crumb-line)))))))
           ;; Embedded Markdown body (`etaf-ui-markdown', zero vw-100 offset!)
           (etaf-web--render-markdown-blocks
            doc
            :theme-mode theme
            :dir page-dir
            :open-link open-link
            :line-grid t
            :max-cols content-cols
            :show-title t)
           ;; Prev / Next chapter cards
           (etaf-web-docs--render-prev-next prev next narrow navigate))))))))))

(defun etaf-web-docs--render-view (st rctx)
  "Render full-height Docs split-tree Page Controller ST for RCTX."
  (let* ((vw (max 44 (or (plist-get rctx :width) 96)))
         (cw (max 1.0 (float (or (plist-get rctx :char-width)
                                 (car (etaf-web--cell-metrics))))))
         (vw-px (or (plist-get rctx :width-px) (round (* vw cw))))
         (theme (or (plist-get rctx :theme) 'auto))
         (narrow (< vw etaf-web-docs--wide-breakpoint))
         (collapsed (etaf-value (plist-get st :collapsed-ref)))
         (dock-sidebar (and (not narrow) (not collapsed)))
         (drawer-open (plist-get st :drawer-open-ref))
         (sidebar-width-ref (plist-get st :sidebar-width-ref))
         (min-px (round (* etaf-web-docs--min-sidebar-cols cw)))
         (max-px (max (+ min-px (round (* 6 cw)))
                      (round (* 0.44 vw-px))))
         (default-px (round (* etaf-web-docs--default-sidebar-cols cw)))
         (raw-px (or (etaf-value sidebar-width-ref) default-px))
         (clamped-px (max min-px (min raw-px max-px)))
         (sidebar-cols (max etaf-web-docs--min-sidebar-cols
                            (round (/ (float clamped-px) cw))))
         (right-cols (if dock-sidebar
                         (max 40 (- vw sidebar-cols 1))
                       vw)))
    (etaf-node
     'flex (list :flex-direction 'column
                 :width 'stretch
                 :height 'stretch
                 :flex-grow 1
                 :flex-basis '(lh 0)
                 :min-height '(lh 0)
                 :overflow 'hidden)
     (list
      (etaf-node
       'flex (list :flex-direction 'row
                   :width 'stretch
                   :height 'stretch
                   :flex-grow 1
                   :flex-basis '(lh 0)
                   :min-height '(lh 0)
                   :overflow 'hidden)
       (delq
        nil
        (list
         ;; Left fixed-width independently scrollable sidebar (same theme canvas)
         (when dock-sidebar
           (etaf-node
            'flex (list :key 'docs-sidebar-pane
                        :flex-direction 'column
                        :width (list 'px clamped-px)
                        :flex-shrink 0
                        :height 'stretch
                        :min-height '(lh 0)
                        :overflow 'hidden
                        :region '(:id docs-sidebar :label "文档目录" :key "d"
                                      :neighbors (:right docs-body)))
            (list (etaf-web-docs--render-sidebar-panel st sidebar-cols nil))))
         ;; Full-height draggable divider (`etaf-pane-resizer')
         (when dock-sidebar
           (etaf-node
            'box (list :key 'docs-resizer-slot :height 'stretch :flex-shrink 0)
            (list
             (etaf-view
              (etaf-pane-resizer
               :ref 'docs-pane-resizer
               :size clamped-px
               :min min-px
               :max max-px
               :on-change (lambda (next-px)
                            (etaf-set-value sidebar-width-ref next-px)))))))
         ;; Right independently scrollable symmetric article pane
         (etaf-web-docs--render-article-pane st right-cols narrow dock-sidebar theme))))
      ;; Left slide-over drawer (automatically suppressed whenever sidebar docks)
      (etaf-view
       (etaf-drawer
        :open (and (not dock-sidebar) (etaf-value drawer-open))
        :title "文档目录"
        :placement 'left
        :width '(ch 34)
        :modal t
        :on-close (lambda () (etaf-set-value drawer-open nil))
        (expr (etaf-web-docs--render-sidebar-panel st 28 t))))))))

